{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ],
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/*.txt",
    "color": {
      "1": "light_red",   // $1 → shell orange
      "2": "light_yellow",  // $2 → snail body (pale yellow)
      "3": "magenta",    // $3 → suit / hat purple
      "4": "dim_green",    // $4 → ground / shadow olive,
      "5": "light_green",
      "6":"black"
    }
  }
}
